{
  "name": "mail",
  "version": "0.1.0",
  "kind": "add",
  "summary": "Opt-in SMTP mail: typed, secret-redacted configuration and a sender that dials once per Send with an explicit TLS policy. Installing it never sends, never connects and never wires itself into HTTP, the database or Loom.",
  "requires": ["base", "config"],
  "files": [
    { "path": "internal/config/mail.go", "source": "files/mail_config.go.tmpl" },
    { "path": "internal/config/mail_test.go", "source": "files/mail_config_test.go.tmpl" },
    { "path": "internal/mailsender/mailsender.go", "source": "files/mailsender.go.tmpl" },
    { "path": "internal/mailsender/mailsender_message.go", "source": "files/mailsender_message.go.tmpl" },
    { "path": "internal/mailsender/mailsender_test.go", "source": "files/mailsender_test.go.tmpl" },
    { "path": "internal/mailsender/README.md", "source": "files/README.md" },
    { "path": "internal/di/mail_provider.go", "source": "files/mail_provider.go.tmpl", "when": ["loom"] }
  ],
  "patches": [
    { "path": "config.yml", "marker": "config", "source": "files/config.snippet", "bootstrap": "config.example.yml" },
    { "path": "config.example.yml", "marker": "config", "source": "files/config.snippet" },
    { "path": "internal/config/config.go", "marker": "configfields", "source": "files/config_fields.snippet" },
    { "path": "internal/config/config.go", "marker": "configenv", "source": "files/config_env.snippet" },
    { "path": "internal/config/config.go", "marker": "configdefaults", "source": "files/config_defaults.snippet" }
  ]
}

package app

import (
	"context"
	"io"
	"log/slog"
	"testing"

	"__module__/internal/config"
)

func testCronLogger() *slog.Logger {
	return slog.New(slog.NewTextHandler(io.Discard, nil))
}

// TestCronRuntimeStartsAndStopsScheduler proves the runtime really builds,
// starts and stops a scheduler, so the capability is wired rather than merely
// compiled. No job fires: the scheduler is exercised with its (default) empty
// registry.
func TestCronRuntimeStartsAndStopsScheduler(t *testing.T) {
	runtime := newCronRuntime(&config.Config{Cron: config.Cron{Timezone: "UTC"}}, testCronLogger())
	if runtime == nil {
		t.Fatal("newCronRuntime returned nil")
	}
	ctx := context.Background()
	if err := runtime.Start(ctx); err != nil {
		t.Fatalf("Start: %v", err)
	}
	if err := runtime.Stop(ctx); err != nil {
		t.Fatalf("Stop: %v", err)
	}
}

// TestCronRuntimeRejectsUnknownTimezone proves a bad cron.timezone fails the
// start rather than silently falling back to local time.
func TestCronRuntimeRejectsUnknownTimezone(t *testing.T) {
	runtime := newCronRuntime(&config.Config{Cron: config.Cron{Timezone: "Not/AZone"}}, testCronLogger())
	if err := runtime.Start(context.Background()); err == nil {
		t.Fatal("Start accepted an unknown timezone")
	}
}

// TestCronRuntimeStopBeforeStartIsSafe proves the runtime Stop is safe when
// serve never reached Start.
func TestCronRuntimeStopBeforeStartIsSafe(t *testing.T) {
	runtime := newCronRuntime(&config.Config{Cron: config.Cron{Timezone: "UTC"}}, testCronLogger())
	if err := runtime.Stop(context.Background()); err != nil {
		t.Fatalf("Stop before Start: %v", err)
	}
}

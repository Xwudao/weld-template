package app

import (
	"strings"
	"testing"
)

func TestServeCommandIsRegistered(t *testing.T) {
	command, ok := commands["serve"]
	if !ok {
		t.Fatal("serve command is not registered")
	}
	if command.Summary == "" || command.Run == nil {
		t.Fatalf("serve command = %+v", command)
	}
}

// TestRunServeRejectsUnknownFlag exercises the command without opening a
// socket: flag parsing fails before Serve is called.
func TestRunServeRejectsUnknownFlag(t *testing.T) {
	err := runServe([]string{"--nope"})
	if err == nil {
		t.Fatal("expected an error for an unknown flag")
	}
	if !strings.Contains(err.Error(), "flag") {
		t.Fatalf("error = %v", err)
	}
}

package httpserver

import (
	"fmt"
	"log/slog"
	"net"
	nethttp "net/http"
	"time"
)

// readHeaderTimeout bounds how long a client may take to send request headers.
const readHeaderTimeout = 5 * time.Second

// NewServer builds the HTTP server for handler without starting it.
//
// It is separate from Serve so tests can inspect the configured server without
// binding a socket.
func NewServer(addr string, handler nethttp.Handler) *nethttp.Server {
	return &nethttp.Server{
		Addr:              addr,
		Handler:           handler,
		ReadHeaderTimeout: readHeaderTimeout,
	}
}

// Serve binds addr, serves handler and returns when the server fails.
//
// The socket is bound synchronously with net.Listen before anything is logged,
// so an address already in use fails here and a failed startup never prints a
// listening line; the listener is then handed to the server. The logger is
// injected rather than created here, so the caller owns the sink and format and
// no package reaches for a global logger.
func Serve(logger *slog.Logger, addr string, handler nethttp.Handler) error {
	listener, err := net.Listen("tcp", addr)
	if err != nil {
		return fmt.Errorf("httpserver: listen on %s: %w", addr, err)
	}
	logger.Info("__name__ listening", "addr", displayAddr(addr))
	server := NewServer(addr, handler)
	return server.Serve(listener)
}

// displayAddr turns a listen address into something clickable.
func displayAddr(addr string) string {
	if addr != "" && addr[0] == ':' {
		return "localhost" + addr
	}
	return addr
}

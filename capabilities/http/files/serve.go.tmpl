package app

import (
	"flag"
	"os"

	httpserver "__module__/internal/httpserver"
	"__module__/internal/logging"
)

func init() {
	// weld:serve:begin
	RegisterCommand(Command{
		Name:    "serve",
		Summary: "start the HTTP server for the installed capabilities",
		Run:     runServe,
	})
	// weld:serve:end
}

// runServe starts the HTTP server that serves every route the installed
// capabilities contributed to internal/httpserver.
//
// It builds the logger with the same base constructor the rest of the process
// uses, then injects it into the server so the listening record goes through
// the one logging protocol.
func runServe(args []string) error {
	flags := flag.NewFlagSet("serve", flag.ContinueOnError)
	flags.SetOutput(os.Stderr)
	addr := flags.String("addr", ":8080", "address to listen on")
	if err := flags.Parse(args); err != nil {
		return err
	}
	logger := logging.New(os.Stderr, logging.TextFormat, nil)
	return httpserver.Serve(logger, *addr, httpserver.Handler())
}

package httpserver

import (
	nethttp "net/http"

	"__module__/internal/api"
)

// installAPIRoute registers the JSON API under /api/. The weld:routes extension
// point wires it into Handler, so route composition stays explicit and needs no
// init-time registration.
//
// The API owns the /api/ namespace. The web capability's SPA handler also
// excludes /api/, so an uninstalled endpoint returns a not-found response rather
// than the HTML shell, in either capability order.
func installAPIRoute(mux *nethttp.ServeMux) {
	api.Register(mux, api.NewService())
}

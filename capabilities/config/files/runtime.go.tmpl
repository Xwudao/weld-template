package config

// Long-running runtime seam.
//
// A capability that must start and stop work with a long-running command (the
// "serve" command) registers a RuntimeFactory here from an init function. The
// serve command builds and starts every registered runtime after it has loaded
// the configuration and built the logger, and stops them on shutdown; help,
// version and every short command never do. This is how such a capability
// follows serve without the serve command knowing the capability exists: config
// is required by every capability that runs a long-lived process, so the seam is
// always present where a long-running command runs.
//
// It lives in config rather than in a command package because the value a
// runtime needs — the loaded *Config — and the logger are already here, and
// because config is installed by every capability that needs the seam, in any
// add order.

import (
	"context"
	"errors"
	"log/slog"
	"sync"
	"time"
)

// runtimeRollbackTimeout bounds how long a failed start waits for the runtimes
// already started to stop. It is a variable rather than a constant so a test can
// exercise the bound without waiting for the default.
var runtimeRollbackTimeout = 10 * time.Second

// Runtime is work that follows a long-running command's lifecycle. Start and
// Stop are called exactly once each, in registration and reverse-registration
// order respectively.
type Runtime interface {
	// Start begins the work. It runs after the command has bound its socket, so
	// a failed bind is reported without starting anything.
	Start(ctx context.Context) error
	// Stop ends the work within ctx's deadline. A runtime that respects ctx
	// returns promptly so shutdown stays bounded.
	Stop(ctx context.Context) error
}

// RuntimeFactory builds a Runtime from the values a long-running command has
// loaded. A factory returns nil to contribute nothing.
type RuntimeFactory func(cfg *Config, logger *slog.Logger) Runtime

var (
	runtimesMu       sync.Mutex
	runtimeFactories []RuntimeFactory
)

// RegisterRuntime appends a runtime factory. It is called from an init
// function, so registration happens before any command runs. A nil factory
// panics, so a capability cannot register nothing by accident.
func RegisterRuntime(factory RuntimeFactory) {
	if factory == nil {
		panic("config: runtime factory must not be nil")
	}
	runtimesMu.Lock()
	defer runtimesMu.Unlock()
	runtimeFactories = append(runtimeFactories, factory)
}

// StartRuntimes builds and starts every registered runtime in registration
// order and returns a function that stops them in reverse order.
//
// If a runtime fails to start, the ones already started are stopped within
// runtimeRollbackTimeout and the error is returned, so a failed start never
// leaves work running and cannot hang on cleanup. A runtime that respects ctx
// returns within that bound. The returned stop function is never nil, so a
// caller can always defer it; it aggregates the stop errors with errors.Join,
// and a failed rollback is joined onto the start error rather than dropped.
func StartRuntimes(ctx context.Context, cfg *Config, logger *slog.Logger) (func(context.Context) error, error) {
	runtimesMu.Lock()
	factories := append([]RuntimeFactory(nil), runtimeFactories...)
	runtimesMu.Unlock()

	started := make([]Runtime, 0, len(factories))
	for _, factory := range factories {
		runtime := factory(cfg, logger)
		if runtime == nil {
			continue
		}
		if err := runtime.Start(ctx); err != nil {
			// Releasing what already started must not be abandoned because the
			// failure canceled ctx, but it must stay bounded: a fresh deadline
			// keeps a runtime that respects ctx from hanging the rollback, and a
			// cleanup failure is reported alongside the start failure.
			rollbackCtx, cancel := context.WithTimeout(context.WithoutCancel(ctx), runtimeRollbackTimeout)
			stopErr := stopRuntimes(rollbackCtx, started)
			cancel()
			return nil, errors.Join(err, stopErr)
		}
		started = append(started, runtime)
	}
	return func(stopCtx context.Context) error {
		return stopRuntimes(stopCtx, started)
	}, nil
}

// stopRuntimes stops runtimes in reverse registration order, aggregating errors
// so one failing stop does not prevent the rest.
func stopRuntimes(ctx context.Context, runtimes []Runtime) error {
	var errs []error
	for i := len(runtimes) - 1; i >= 0; i-- {
		if err := runtimes[i].Stop(ctx); err != nil {
			errs = append(errs, err)
		}
	}
	return errors.Join(errs...)
}

package config

import (
	"context"
	"errors"
	"io"
	"log/slog"
	"strings"
	"testing"
	"time"
)

// testLogger is the injected logger for runtime tests that do not assert on
// output.
func testLogger() *slog.Logger {
	return slog.New(slog.NewTextHandler(io.Discard, nil))
}

// recordingRuntime records its transitions in the shared slice it is built
// with, so the tests can assert the start and stop order without a scheduler.
type recordingRuntime struct {
	name  string
	order *[]string
	fail  bool
}

func (r recordingRuntime) Start(context.Context) error {
	if r.fail {
		return errors.New("boom")
	}
	*r.order = append(*r.order, "start:"+r.name)
	return nil
}

func (r recordingRuntime) Stop(context.Context) error {
	*r.order = append(*r.order, "stop:"+r.name)
	return nil
}

// blockingStopRuntime blocks until its context is done, then records that it
// returned. It respects ctx, so the rollback bound is what releases it.
type blockingStopRuntime struct {
	order *[]string
}

func (r blockingStopRuntime) Start(context.Context) error { return nil }

func (r blockingStopRuntime) Stop(ctx context.Context) error {
	<-ctx.Done()
	*r.order = append(*r.order, "stop:blocked")
	return ctx.Err()
}

// failingStopRuntime returns a fixed error from Stop.
type failingStopRuntime struct{ err error }

func (r failingStopRuntime) Start(context.Context) error { return nil }
func (r failingStopRuntime) Stop(context.Context) error  { return r.err }

// resetRuntimes clears the registration registry for a test and restores it
// afterwards, so the process-global seam stays isolated between tests.
func resetRuntimes(t *testing.T) {
	t.Helper()
	runtimesMu.Lock()
	previous := runtimeFactories
	runtimeFactories = nil
	runtimesMu.Unlock()
	t.Cleanup(func() {
		runtimesMu.Lock()
		runtimeFactories = previous
		runtimesMu.Unlock()
	})
}

// TestStartRuntimesWithoutFactoriesIsSafe proves the serve command can always
// call the seam: with nothing registered it starts nothing and returns a
// non-nil stop function that does nothing.
func TestStartRuntimesWithoutFactoriesIsSafe(t *testing.T) {
	resetRuntimes(t)
	stop, err := StartRuntimes(context.Background(), &Config{}, testLogger())
	if err != nil {
		t.Fatalf("StartRuntimes: %v", err)
	}
	if stop == nil {
		t.Fatal("StartRuntimes returned a nil stop function")
	}
	if err := stop(context.Background()); err != nil {
		t.Fatalf("stop: %v", err)
	}
}

// TestStartRuntimesStartsInOrderAndStopsInReverse pins the lifecycle contract
// serve relies on: runtimes start in registration order and stop in reverse, so
// a runtime that depends on another tears down first.
func TestStartRuntimesStartsInOrderAndStopsInReverse(t *testing.T) {
	resetRuntimes(t)
	var order []string
	RegisterRuntime(func(*Config, *slog.Logger) Runtime { return recordingRuntime{name: "first", order: &order} })
	RegisterRuntime(func(*Config, *slog.Logger) Runtime { return recordingRuntime{name: "second", order: &order} })

	stop, err := StartRuntimes(context.Background(), &Config{}, testLogger())
	if err != nil {
		t.Fatalf("StartRuntimes: %v", err)
	}
	if got := strings.Join(order, ","); got != "start:first,start:second" {
		t.Fatalf("start order = %q", got)
	}
	if err := stop(context.Background()); err != nil {
		t.Fatalf("stop: %v", err)
	}
	if got := strings.Join(order, ","); got != "start:first,start:second,stop:second,stop:first" {
		t.Fatalf("lifecycle order = %q", got)
	}
}

// TestStartRuntimesRollsBackOnStartFailure proves a runtime that fails to start
// stops the ones already started and returns the error, so a failed start never
// leaves work running.
func TestStartRuntimesRollsBackOnStartFailure(t *testing.T) {
	resetRuntimes(t)
	var order []string
	RegisterRuntime(func(*Config, *slog.Logger) Runtime { return recordingRuntime{name: "ok", order: &order} })
	RegisterRuntime(func(*Config, *slog.Logger) Runtime { return recordingRuntime{name: "bad", order: &order, fail: true} })

	stop, err := StartRuntimes(context.Background(), &Config{}, testLogger())
	if err == nil {
		t.Fatal("StartRuntimes succeeded despite a failing runtime")
	}
	if stop != nil {
		t.Fatal("StartRuntimes returned a stop function alongside an error")
	}
	if got := strings.Join(order, ","); got != "start:ok,stop:ok" {
		t.Fatalf("rollback order = %q", got)
	}
}

// TestStartRuntimesRollbackIsBounded proves a failed start does not hang on a
// context-respecting runtime that blocks in Stop: the rollback deadline releases
// it, and its stop error is joined onto the start error rather than dropped.
func TestStartRuntimesRollbackIsBounded(t *testing.T) {
	resetRuntimes(t)
	previous := runtimeRollbackTimeout
	runtimeRollbackTimeout = 25 * time.Millisecond
	t.Cleanup(func() { runtimeRollbackTimeout = previous })

	var order []string
	RegisterRuntime(func(*Config, *slog.Logger) Runtime { return blockingStopRuntime{order: &order} })
	RegisterRuntime(func(*Config, *slog.Logger) Runtime { return recordingRuntime{name: "bad", order: &order, fail: true} })

	start := time.Now()
	_, err := StartRuntimes(context.Background(), &Config{}, testLogger())
	if err == nil {
		t.Fatal("StartRuntimes succeeded despite a failing runtime")
	}
	if elapsed := time.Since(start); elapsed > 5*time.Second {
		t.Fatalf("rollback took %s; the rollback context was not bounded", elapsed)
	}
	if got := strings.Join(order, ","); got != "stop:blocked" {
		t.Fatalf("rollback order = %q", got)
	}
	if !errors.Is(err, context.DeadlineExceeded) {
		t.Fatalf("start error %v does not report the bounded cleanup failure", err)
	}
}

// TestStartRuntimesReportsStopFailure proves the stop function returns a
// runtime's Stop error rather than swallowing it, which is the contract serve
// relies on to fail loudly when teardown fails.
func TestStartRuntimesReportsStopFailure(t *testing.T) {
	resetRuntimes(t)
	sentinel := errors.New("stop failed")
	RegisterRuntime(func(*Config, *slog.Logger) Runtime { return recordingRuntime{name: "ok", order: new([]string)} })
	RegisterRuntime(func(*Config, *slog.Logger) Runtime { return failingStopRuntime{err: sentinel} })

	stop, err := StartRuntimes(context.Background(), &Config{}, testLogger())
	if err != nil {
		t.Fatalf("StartRuntimes: %v", err)
	}
	if err := stop(context.Background()); !errors.Is(err, sentinel) {
		t.Fatalf("stop error = %v, want %v", err, sentinel)
	}
}

// TestRegisterRuntimeRejectsNil proves a capability cannot register nothing by
// accident.
func TestRegisterRuntimeRejectsNil(t *testing.T) {
	defer func() {
		if recover() == nil {
			t.Fatal("RegisterRuntime(nil) did not panic")
		}
	}()
	RegisterRuntime(nil)
}

package server

import "io/fs"

// assetProviders is the weld-owned extension point for static assets.
//
// Capabilities such as "web" register a filesystem here through RegisterAssets.
// The base scaffold registers none, so the app builds and runs without any
// frontend dependency.
var assetProviders []func() fs.FS

// RegisterAssets adds a provider for the static asset filesystem.
func RegisterAssets(provider func() fs.FS) {
	assetProviders = append(assetProviders, provider)
}

// assetFS returns the first asset filesystem registered by a capability.
func assetFS() fs.FS {
	for _, provider := range assetProviders {
		if files := provider(); files != nil {
			return files
		}
	}
	return nil
}

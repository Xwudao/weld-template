// Package app wires the __name__ command line.
package app

import (
	"fmt"
	"io"
	"os"
)

// Version is the application version.
const Version = "__version__"

// Run dispatches the command line arguments.
func Run(args []string) error {
	if len(args) == 0 {
		Usage(os.Stdout)
		return nil
	}
	switch args[0] {
	case "serve":
		return runServe(args[1:])
	case "version", "--version", "-v":
		fmt.Println("__name__ " + Version)
		return nil
	case "help", "--help", "-h":
		Usage(os.Stdout)
		return nil
	default:
		return fmt.Errorf("unknown command %q (run \"__name__ help\")", args[0])
	}
}

// Usage writes the command help to w.
func Usage(w io.Writer) {
	fmt.Fprint(w, `__name__ - minimal Go CLI generated by weld

Usage:
  __name__ serve [--addr :8080]   start the HTTP server
  __name__ version                print the version
  __name__ help                   show this help
`)
}

// Package app wires the __name__ command line.
package app

import (
	"fmt"
	"io"
	"os"
	"sort"
)

// Version is the application version.
const Version = "__version__"

// Command is a subcommand of the generated CLI.
type Command struct {
	// Name is the word typed on the command line.
	Name string
	// Summary is the one-line description shown by Usage.
	Summary string
	// Run executes the command with the arguments that follow its name.
	Run func(args []string) error
}

// commands is the weld-owned extension point for capability commands.
//
// The base scaffold registers no commands of its own: a capability adds a file
// whose init function calls RegisterCommand. That keeps the base project free
// of capability dependencies — it compiles and runs with no HTTP server, no
// database and no frontend — and lets capabilities such as "http" (serve) and
// "api" register their commands independently of one another.
var commands = map[string]Command{}

// RegisterCommand adds a capability command. It panics on an empty or duplicate
// name so two capabilities cannot silently shadow each other.
func RegisterCommand(command Command) {
	if command.Name == "" || command.Run == nil {
		panic("app: command needs a name and a run function")
	}
	if _, exists := commands[command.Name]; exists {
		panic("app: duplicate command " + command.Name)
	}
	commands[command.Name] = command
}

// Run dispatches the command line arguments.
func Run(args []string) error {
	if len(args) == 0 {
		Usage(os.Stdout)
		return nil
	}
	switch args[0] {
	case "version", "--version", "-v":
		fmt.Println("__name__ " + Version)
		return nil
	case "help", "--help", "-h":
		Usage(os.Stdout)
		return nil
	}
	command, ok := commands[args[0]]
	if !ok {
		return fmt.Errorf("unknown command %q (run \"__name__ help\")", args[0])
	}
	return command.Run(args[1:])
}

// Usage writes the command help to w.
func Usage(w io.Writer) {
	fmt.Fprint(w, `__name__ - minimal Go CLI generated by weld

Usage:
  __name__ <command> [arguments]

Built-in commands:
  version          print the version
  help             show this help
`)
	if listed := sortedCommands(); len(listed) > 0 {
		fmt.Fprint(w, "\nCapability commands:\n")
		for _, command := range listed {
			fmt.Fprintf(w, "  %-16s %s\n", command.Name, command.Summary)
		}
	}
}

func sortedCommands() []Command {
	names := make([]string, 0, len(commands))
	for name := range commands {
		names = append(names, name)
	}
	sort.Strings(names)
	listed := make([]Command, 0, len(names))
	for _, name := range names {
		listed = append(listed, commands[name])
	}
	return listed
}

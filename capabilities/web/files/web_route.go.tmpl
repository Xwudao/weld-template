package httpserver

import (
	nethttp "net/http"

	"__module__/internal/web"
)

// installWebRoute registers the frontend SPA handler at the root. The
// weld:routes extension point wires it into Handler, so route composition stays
// explicit and needs no init-time registration.
//
// "/" is a catch-all; a route registered by another capability (the api
// capability's "/api/") takes precedence for its own subtree. The SPA handler
// also excludes the reserved /api/ namespace, so an uninstalled API 404s instead of
// returning the HTML shell.
func installWebRoute(mux *nethttp.ServeMux) {
	mux.Handle("/", web.Handler())
}

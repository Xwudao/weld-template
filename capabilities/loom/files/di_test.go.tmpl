// The tests here exercise the composed graph without PostgreSQL: the pool is
// only parsed (never connected), the API service is driven through an injected
// in-memory repository or the default service, and the lifecycle's bind,
// serve-failure and graceful-stop behavior is checked on loopback sockets.

// fakeEnv returns an EnvLookup over the given values, so configuration tests
// never touch the process environment.
func fakeEnv(values map[string]string) EnvLookup {
	return func(key string) (string, bool) {
		value, ok := values[key]
		return value, ok
	}
}

// baseEnv is an environment that satisfies NewConfig for the installed
// capabilities. When db is installed the dsn is always supplied explicitly, as
// the graph requires; no test reaches a real database.
func baseEnv() EnvLookup {
{{- if .Caps.Has "db"}}
	return fakeEnv(map[string]string{DatabaseURLEnv: "postgres://example/db?sslmode=disable"})
{{- else}}
	return fakeEnv(nil)
{{- end}}
}

func TestNewConfigDefaultsToLoopbackPort(t *testing.T) {
	cfg, err := NewConfig(context.Background(), baseEnv())
	if err != nil {
		t.Fatalf("NewConfig: %v", err)
	}
	if cfg.Addr != ":8080" {
		t.Fatalf("Addr = %q, want :8080", cfg.Addr)
	}
}

func TestWithAddrOverridesConfig(t *testing.T) {
	cfg, err := NewConfig(WithAddr(context.Background(), "127.0.0.1:0"), baseEnv())
	if err != nil {
		t.Fatalf("NewConfig: %v", err)
	}
	if cfg.Addr != "127.0.0.1:0" {
		t.Fatalf("Addr = %q, want 127.0.0.1:0", cfg.Addr)
	}
}

func TestNewConfigRejectsBlankAddr(t *testing.T) {
	if _, err := NewConfig(WithAddr(context.Background(), "  "), baseEnv()); err == nil {
		t.Fatal("expected an error for a blank listen address")
	}
}

// newServerForTest builds a server against the installed graph providers,
// injecting the default or in-memory service so the bind/serve lifecycle is
// exercised without PostgreSQL.
func newServerForTest(t *testing.T, lifecycle *loom.Lifecycle, addr string) *Server {
	t.Helper()
	server, err := NewServer(lifecycle, &Config{Addr: addr}{{if .Caps.Has "api"}}, NewAPIService({{if .Caps.Has "db"}}newFakeRepository(){{end}}){{end}})
	if err != nil {
		t.Fatalf("NewServer: %v", err)
	}
	return server
}

// TestServerBindFailureFailsStart proves a port already in use fails Start
// instead of being swallowed by a background goroutine.
func TestServerBindFailureFailsStart(t *testing.T) {
	occupied, err := net.Listen("tcp", "127.0.0.1:0")
	if err != nil {
		t.Fatalf("listen: %v", err)
	}
	defer occupied.Close()

	lifecycle := loom.NewLifecycle()
	newServerForTest(t, lifecycle, occupied.Addr().String())
	if err := lifecycle.Start(context.Background()); err == nil {
		t.Fatal("Start succeeded on an occupied port")
	}
}

// TestServerReportsRuntimeFailure proves a serve failure reaches the command
// instead of leaving it waiting forever.
func TestServerReportsRuntimeFailure(t *testing.T) {
	lifecycle := loom.NewLifecycle()
	server := newServerForTest(t, lifecycle, "127.0.0.1:0")
	ctx := context.Background()
	if err := lifecycle.Start(ctx); err != nil {
		t.Fatalf("Start: %v", err)
	}
	defer func() { _ = lifecycle.Stop(ctx) }()

	// Closing the bound listener directly is not a graceful shutdown, so Serve
	// returns an error rather than net/http.ErrServerClosed.
	if err := server.listener.Close(); err != nil {
		t.Fatalf("close listener: %v", err)
	}
	select {
	case err := <-server.Fail():
		if err == nil {
			t.Fatal("expected a serve error, got nil")
		}
	case <-time.After(5 * time.Second):
		t.Fatal("timed out waiting for the serve failure")
	}
}

// TestServerStopsGracefully proves a normal stop ends the serving goroutine
// without reporting a failure.
func TestServerStopsGracefully(t *testing.T) {
	lifecycle := loom.NewLifecycle()
	server := newServerForTest(t, lifecycle, "127.0.0.1:0")
	ctx := context.Background()
	if err := lifecycle.Start(ctx); err != nil {
		t.Fatalf("Start: %v", err)
	}
	if err := lifecycle.Stop(ctx); err != nil {
		t.Fatalf("Stop: %v", err)
	}
	select {
	case err := <-server.Fail():
		if err != nil {
			t.Fatalf("serve ended with %v, want nil after graceful shutdown", err)
		}
	case <-time.After(5 * time.Second):
		t.Fatal("timed out waiting for the server to stop")
	}
}


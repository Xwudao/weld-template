func TestNewConfigReadsInjectedDatabaseURL(t *testing.T) {
	cfg, err := NewConfig(context.Background(), fakeEnv(map[string]string{DatabaseURLEnv: "postgres://example/db?sslmode=disable"}))
	if err != nil {
		t.Fatalf("NewConfig: %v", err)
	}
	if cfg.DatabaseURL != "postgres://example/db?sslmode=disable" {
		t.Fatalf("DatabaseURL = %q", cfg.DatabaseURL)
	}
}

// TestNewConfigRequiresDatabaseURL proves the graph never invents a dsn: an
// unset variable fails loudly rather than silently pointing at a local database.
func TestNewConfigRequiresDatabaseURL(t *testing.T) {
	if _, err := NewConfig(context.Background(), fakeEnv(nil)); err == nil {
		t.Fatal("expected an error when DATABASE_URL is unset")
	}
}

// TestNewConfigRejectsBlankDatabaseURL treats a whitespace-only value as unset.
func TestNewConfigRejectsBlankDatabaseURL(t *testing.T) {
	if _, err := NewConfig(context.Background(), fakeEnv(map[string]string{DatabaseURLEnv: "   "})); err == nil {
		t.Fatal("expected an error when DATABASE_URL is blank")
	}
}

// TestNewPoolParsesWithoutConnecting proves the graph builds the pool without a
// running database (pgxpool parses the dsn lazily) and returns a cleanup that
// closes it exactly once.
func TestNewPoolParsesWithoutConnecting(t *testing.T) {
	pool, cleanup, err := NewPool(context.Background(), &Config{Addr: ":8080", DatabaseURL: "postgres://localhost:5432/{{.Name}}?sslmode=disable"})
	if err != nil {
		t.Fatalf("NewPool: %v", err)
	}
	if pool == nil {
		t.Fatal("NewPool returned a nil pool")
	}
	if cleanup == nil {
		t.Fatal("NewPool returned no cleanup")
	}
	if err := cleanup(context.Background()); err != nil {
		t.Fatalf("cleanup: %v", err)
	}
	// The lifecycle calls a cleanup once, and it must stay safe if called again.
	if err := cleanup(context.Background()); err != nil {
		t.Fatalf("second cleanup: %v", err)
	}
}

// fakeRepository is an in-memory data.Repository injected directly, so the
// adapter and the composed route are exercised without PostgreSQL.
type fakeRepository struct {
	mu    sync.Mutex
	items map[string]data.Item
}

func newFakeRepository() *fakeRepository {
	return &fakeRepository{items: map[string]data.Item{}}
}

func (r *fakeRepository) CreateItem(_ context.Context, item data.Item) (data.Item, error) {
	r.mu.Lock()
	defer r.mu.Unlock()
	r.items[item.ID] = item
	return item, nil
}

func (r *fakeRepository) GetItem(_ context.Context, id string) (data.Item, error) {
	r.mu.Lock()
	defer r.mu.Unlock()
	item, ok := r.items[id]
	if !ok {
		return data.Item{}, data.ErrNotFound
	}
	return item, nil
}

func (r *fakeRepository) ListItems(_ context.Context, limit int) ([]data.Item, error) {
	r.mu.Lock()
	defer r.mu.Unlock()
	items := make([]data.Item, 0, len(r.items))
	for _, item := range r.items {
		if len(items) >= limit {
			break
		}
		items = append(items, item)
	}
	return items, nil
}

func TestRepositoryServicePersistsThroughInjectedRepository(t *testing.T) {
	service := NewAPIService(newFakeRepository())
	created, err := service.Create(context.Background(), api.CreateItemRequest{
		Name: "widget", Quantity: 3, Status: api.ItemStatusActive,
	})
	if err != nil {
		t.Fatalf("Create: %v", err)
	}
	if created.ID == "" || created.Name != "widget" {
		t.Fatalf("created = %+v", created)
	}
	got, err := service.Get(context.Background(), created.ID)
	if err != nil {
		t.Fatalf("Get: %v", err)
	}
	if got != created {
		t.Fatalf("Get = %+v, want %+v", got, created)
	}
	if _, err := service.Get(context.Background(), "missing"); err == nil {
		t.Fatal("missing item did not map to an error")
	}
}

// The tests here exercise the composed graph without PostgreSQL: the pool is
// only parsed (never connected), the API service is driven through an injected
// in-memory repository or the default service, and the lifecycle's bind,
// serve-failure and graceful-stop behavior is checked on loopback sockets.

// fakeLoader builds a config.Loader over in-memory files and environment, so
// configuration tests never touch the filesystem or the process environment.
func fakeLoader(files, env map[string]string) *config.Loader {
	readFile := func(name string) ([]byte, error) {
		content, ok := files[name]
		if !ok {
			return nil, fs.ErrNotExist
		}
		return []byte(content), nil
	}
	lookupEnv := func(key string) (string, bool) {
		value, ok := env[key]
		return value, ok
	}
	return config.NewLoader(readFile, lookupEnv)
}

// dbEnv satisfies ValidateDatabase when the db capability is installed; no test
// reaches a real database.
func dbEnv() map[string]string {
{{- if .Caps.Has "db"}}
	return map[string]string{
		config.EnvDBHost: "localhost",
		config.EnvDBPort: "5432",
		config.EnvDBUser: "app",
		config.EnvDBName: "app",
	}
{{- else}}
	return nil
{{- end}}
}

// baseLoader is a loader that satisfies NewConfig for the installed
// capabilities.
func baseLoader() *config.Loader {
	return fakeLoader(map[string]string{config.DefaultPath: ""}, dbEnv())
}

func TestNewConfigDefaultsToLoopbackPort(t *testing.T) {
	cfg, err := NewConfig(context.Background(), baseLoader())
	if err != nil {
		t.Fatalf("NewConfig: %v", err)
	}
	if cfg.HTTP.Addr != ":8080" {
		t.Fatalf("HTTP.Addr = %q, want :8080", cfg.HTTP.Addr)
	}
}

// TestWithAddrOverridesConfig proves the command-line flag outranks the file.
func TestWithAddrOverridesConfig(t *testing.T) {
	loader := fakeLoader(map[string]string{config.DefaultPath: "http:\n  addr: \":9999\"\n"}, dbEnv())
	cfg, err := NewConfig(WithAddr(context.Background(), "127.0.0.1:0"), loader)
	if err != nil {
		t.Fatalf("NewConfig: %v", err)
	}
	if cfg.HTTP.Addr != "127.0.0.1:0" {
		t.Fatalf("HTTP.Addr = %q, want 127.0.0.1:0", cfg.HTTP.Addr)
	}
}

func TestNewConfigRejectsBlankAddr(t *testing.T) {
	if _, err := NewConfig(WithAddr(context.Background(), "  "), baseLoader()); err == nil {
		t.Fatal("expected an error for a blank listen address")
	}
}

// newServerForTest builds a server against the installed graph providers,
// injecting the default or in-memory service and a logger so the bind/serve
// lifecycle is exercised without PostgreSQL and without a global logger.
func newServerForTest(t *testing.T, lifecycle *loom.Lifecycle, addr string, logger *slog.Logger) *Server {
	t.Helper()
	server, err := NewServer(lifecycle, &config.Config{HTTP: config.HTTP{Addr: addr}}, logger{{if .Caps.Has "api"}}, NewAPIService({{if .Caps.Has "db"}}newFakeRepository(){{end}}){{end}})
	if err != nil {
		t.Fatalf("NewServer: %v", err)
	}
	return server
}

// discardLogger is the injected logger for lifecycle tests that do not assert
// on output.
func discardLogger() *slog.Logger {
	return logging.New(io.Discard, logging.TextFormat, nil)
}

// TestServerBindFailureFailsStart proves a port already in use fails Start
// instead of being swallowed by a background goroutine.
func TestServerBindFailureFailsStart(t *testing.T) {
	occupied, err := net.Listen("tcp", "127.0.0.1:0")
	if err != nil {
		t.Fatalf("listen: %v", err)
	}
	defer occupied.Close()

	lifecycle := loom.NewLifecycle()
	newServerForTest(t, lifecycle, occupied.Addr().String(), discardLogger())
	if err := lifecycle.Start(context.Background()); err == nil {
		t.Fatal("Start succeeded on an occupied port")
	}
}

// TestServerReportsRuntimeFailure proves a serve failure reaches the command
// instead of leaving it waiting forever.
func TestServerReportsRuntimeFailure(t *testing.T) {
	lifecycle := loom.NewLifecycle()
	server := newServerForTest(t, lifecycle, "127.0.0.1:0", discardLogger())
	ctx := context.Background()
	if err := lifecycle.Start(ctx); err != nil {
		t.Fatalf("Start: %v", err)
	}
	defer func() { _ = lifecycle.Stop(ctx) }()

	// Closing the bound listener directly is not a graceful shutdown, so Serve
	// returns an error rather than net/http.ErrServerClosed.
	if err := server.listener.Close(); err != nil {
		t.Fatalf("close listener: %v", err)
	}
	select {
	case err := <-server.Fail():
		if err == nil {
			t.Fatal("expected a serve error, got nil")
		}
	case <-time.After(5 * time.Second):
		t.Fatal("timed out waiting for the serve failure")
	}
}

// TestServerStopsGracefully proves a normal stop ends the serving goroutine
// without reporting a failure.
func TestServerStopsGracefully(t *testing.T) {
	lifecycle := loom.NewLifecycle()
	server := newServerForTest(t, lifecycle, "127.0.0.1:0", discardLogger())
	ctx := context.Background()
	if err := lifecycle.Start(ctx); err != nil {
		t.Fatalf("Start: %v", err)
	}
	if err := lifecycle.Stop(ctx); err != nil {
		t.Fatalf("Stop: %v", err)
	}
	select {
	case err := <-server.Fail():
		if err != nil {
			t.Fatalf("serve ended with %v, want nil after graceful shutdown", err)
		}
	case <-time.After(5 * time.Second):
		t.Fatal("timed out waiting for the server to stop")
	}
}

// TestServerLogsLifecycle proves the server logs through the injected logger:
// a buffer as the sink records the startup and shutdown transitions, and no
// global logger is involved.
func TestServerLogsLifecycle(t *testing.T) {
	var buf bytes.Buffer
	logger := logging.New(&buf, logging.TextFormat, nil)
	lifecycle := loom.NewLifecycle()
	server := newServerForTest(t, lifecycle, "127.0.0.1:0", logger)
	ctx := context.Background()
	if err := lifecycle.Start(ctx); err != nil {
		t.Fatalf("Start: %v", err)
	}
	if err := lifecycle.Stop(ctx); err != nil {
		t.Fatalf("Stop: %v", err)
	}
	select {
	case <-server.Fail():
	case <-time.After(5 * time.Second):
		t.Fatal("timed out waiting for the server to stop")
	}
	out := buf.String()
	if !strings.Contains(out, "listening") {
		t.Fatalf("startup was not logged through the injected logger:\n%s", out)
	}
	if !strings.Contains(out, "shutting down") {
		t.Fatalf("shutdown was not logged through the injected logger:\n%s", out)
	}
}


package app

import (
	"context"
	"errors"
	"flag"
	"os"
	"os/signal"
	"syscall"
	"time"

	"__module__/internal/di"
)

// shutdownTimeout bounds graceful teardown after the process receives a signal.
const shutdownTimeout = 10 * time.Second

// runServeLoom starts the server through the generated Loom graph.
//
// The graph owns construction and the lifecycle; this command only resolves the
// configuration path and the listen address, installs signal handling and drives
// Start/Stop, so context cancellation reaches the managed HTTP server. It returns
// when a signal arrives or the server fails, then stops the lifecycle gracefully
// and reports any shutdown error alongside that failure.
func runServeLoom(args []string) (err error) {
	flags := flag.NewFlagSet("serve", flag.ContinueOnError)
	flags.SetOutput(os.Stderr)
	configPath := flags.String("config", "", "path to config.yml (default ./config.yml)")
	addr := flags.String("addr", "", "address to listen on (overrides config and environment)")
	if err := flags.Parse(args); err != nil {
		return err
	}

	ctx, stop := signal.NotifyContext(context.Background(), os.Interrupt, syscall.SIGTERM)
	defer stop()
	ctx = di.WithConfigPath(ctx, *configPath)
	// A command-line flag outranks the environment and the file, so the graph is
	// told about the address only when it was actually set.
	if flagSet(flags, "addr") {
		ctx = di.WithAddr(ctx, *addr)
	}

	app, lifecycle, err := di.InitApp(ctx)
	if err != nil {
		return err
	}
	if err := lifecycle.Start(ctx); err != nil {
		return err
	}
	defer func() {
		shutdownCtx, cancel := context.WithTimeout(context.Background(), shutdownTimeout)
		defer cancel()
		err = errors.Join(err, lifecycle.Stop(shutdownCtx))
	}()

	// The graph's injected logger records startup, failure and shutdown from the
	// server lifecycle, so this command only drives Start/Stop.
	select {
	case <-ctx.Done():
		return nil
	case serveErr := <-app.Server.Fail():
		return serveErr
	}
}

// flagSet reports whether name was provided on the command line.
func flagSet(flags *flag.FlagSet, name string) bool {
	found := false
	flags.Visit(func(f *flag.Flag) {
		if f.Name == name {
			found = true
		}
	})
	return found
}

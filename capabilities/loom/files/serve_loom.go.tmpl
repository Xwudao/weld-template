package app

import (
	"context"
	"errors"
	"os"
	"os/signal"
	"syscall"
	"time"

	"github.com/spf13/cobra"

	"__module__/internal/di"
)

// shutdownTimeout bounds graceful teardown after the process receives a signal.
const shutdownTimeout = 10 * time.Second

// newServeLoomCommand builds the serve command backed by the generated Loom
// graph. It replaces the plain serve command once loom is installed, so a bare
// `__name__` and `__name__ serve` both run the graph.
func newServeLoomCommand() *cobra.Command {
	return &cobra.Command{
		Use:   "serve",
		Short: "start the HTTP server from the Loom application graph",
		Args:  cobra.NoArgs,
		RunE:  runServeLoom,
	}
}

// runServeLoom starts the server through the generated Loom graph.
//
// The graph owns construction and the lifecycle; this command only resolves the
// configuration path and the listen address from the shared root flags, installs
// signal handling and drives Start/Stop, so context cancellation reaches the
// managed HTTP server. It returns when a signal arrives or the server fails,
// then stops the lifecycle gracefully and reports any shutdown error alongside
// that failure.
func runServeLoom(cmd *cobra.Command, args []string) (err error) {
	request, err := parseServeRequest(cmd)
	if err != nil {
		return err
	}

	ctx, stop := signal.NotifyContext(context.Background(), os.Interrupt, syscall.SIGTERM)
	defer stop()
	ctx = di.WithConfigPath(ctx, request.configPath)
	// A command-line flag outranks the environment and the file, so the graph is
	// told about the address only when it was actually set.
	if request.addrSet {
		ctx = di.WithAddr(ctx, request.addr)
	}

	application, lifecycle, err := di.InitApp(ctx)
	if err != nil {
		return err
	}
	if err := lifecycle.Start(ctx); err != nil {
		return err
	}
	defer func() {
		shutdownCtx, cancel := context.WithTimeout(context.Background(), shutdownTimeout)
		defer cancel()
		err = errors.Join(err, lifecycle.Stop(shutdownCtx))
	}()

	// The graph's injected logger records startup, failure and shutdown from the
	// server lifecycle, so this command only drives Start/Stop.
	select {
	case <-ctx.Done():
		return nil
	case serveErr := <-application.Server.Fail():
		return serveErr
	}
}

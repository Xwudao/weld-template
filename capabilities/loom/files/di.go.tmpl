// Package di wires the {{.Name}} application with Loom.
//
// InitApp is generated from the graph below: Loom constructs the configuration,
{{- if .Caps.Has "api"}} the JSON API service,{{end}}
// and the HTTP server, registers the server start and stop hooks with the
// lifecycle, and returns the application and its lifecycle. The graph is the
// only place that knows the whole composition; the capabilities themselves stay
// independent.
//
// The graph is capability aware: installing a capability that feeds it (api,
// db, redis, mail, storage or cron) regenerates this file and
// internal/di/loom_gen.go, so the composed application follows the installed
// capabilities without a runtime registry or service locator. Do not edit this
// file: it is regenerated. The stable provider seams live in separate files weld
// writes once and never regenerates, so wiring there survives every later
// `weld add`: the API service in internal/di/api_provider.go, and the Redis,
// mail, object-store and cron providers in internal/di/redis_provider.go,
// internal/di/mail_provider.go, internal/di/storage_provider.go and
// internal/di/cron_provider.go.
//
// Business modules installed with `weld add module` are provided by their own
// package's NewService and registered on the mux below. They are re-rendered
// from weld.json, so a module added after Loom appears in this graph without
// weld editing any file in the module package.
//
// Installing db adds the pool and repository as available bindings, but nothing
// in the default graph depends on data.Repository, so Loom prunes them: an
// ordinary serve never constructs a pool and never needs a database credential.
// The db capability is a library the user wires into their own providers
// explicitly (see internal/data/README.md); Loom constructs the pool only when a
// consumer asks for data.Repository. Installing redis, mail or storage likewise
// adds a binding and prunes it unless a provider asks for *redis.Client,
// *mailsender.Sender or *objectstore.Store (see internal/redisclient/README.md,
// internal/mailsender/README.md and internal/objectstore/README.md). Installing
// cron is different: the graph root consumes *cron.Scheduler, so the scheduler is
// constructed and its start/stop hooks are registered, and the scheduler starts
// empty until internal/cron/register.go registers jobs.
package di

import (
	"context"
	"errors"
	"fmt"
	"log/slog"
	"net"
	nethttp "net/http"
	"os"
	"strings"
	"time"

	"github.com/Xwudao/loom"
{{- if .Caps.Has "api"}}
	"__module__/internal/api"
{{- end}}
	"__module__/internal/config"
{{- if .Caps.Has "cron"}}
	"__module__/internal/cron"
{{- end}}
{{- if .Caps.Has "db"}}
	"github.com/jackc/pgx/v5/pgxpool"
	"__module__/internal/data"
{{- end}}
{{- range .Modules}}
	"__module__/internal/modules/{{.Name}}"
{{- end}}
	"__module__/internal/httpserver"
	"__module__/internal/logging"
{{- if .Caps.Has "web"}}
	"__module__/internal/web"
{{- end}}
)

var appGraph = loom.Graph[*App](
	loom.Name("InitApp"),
	loom.WithContext(),
	loom.Provide(NewConfigLoader),
	loom.Provide(NewConfig),
	loom.Provide(NewLogger),
{{- if .Caps.Has "db"}}
	// The pool and repository are declared bindings, not part of the default
	// composition: nothing in this graph depends on data.Repository, so Loom
	// prunes them and an unrelated serve never opens a pool.
	loom.Provide(NewPool),
	loom.As[data.Repository](NewRepository),
{{- end}}
{{- if .Caps.Has "api"}}
	// The provider is defined in api_provider.go, the stable wiring seam; edit
	// that file to persist the API, never this regenerated graph.
	loom.Provide(NewAPIService),
{{- end}}
{{- range .Modules}}
	// The provider is the module package's NewService, written once by
	// `weld add module` and never regenerated; edit it to replace the demo.
	loom.Provide({{.Name}}.NewService),
{{- end}}
{{- if .Caps.Has "redis"}}
	// The Redis client is a declared binding, not part of the default
	// composition: nothing in this graph depends on *redis.Client, so Loom prunes
	// it and an unrelated serve never constructs a client and never needs a Redis
	// setting. It is defined in redis_provider.go, the stable wiring seam; edit a
	// provider this graph consumes to depend on *redis.Client to switch it on.
	loom.Provide(NewRedisClient),
{{- end}}
{{- if .Caps.Has "mail"}}
	// The SMTP sender is a declared binding, not part of the default
	// composition: nothing in this graph depends on *mailsender.Sender, so Loom
	// prunes it and an unrelated serve never constructs a sender and never needs a
	// mail setting. It is defined in mail_provider.go, the stable wiring seam;
	// edit a provider this graph consumes to depend on *mailsender.Sender to
	// switch it on.
	loom.Provide(NewMailSender),
{{- end}}
{{- if .Caps.Has "storage"}}
	// The object store is a declared binding, not part of the default
	// composition: nothing in this graph depends on *objectstore.Store, so Loom
	// prunes it and an unrelated serve never constructs a store and never needs a
	// storage setting. It is defined in storage_provider.go, the stable wiring
	// seam; edit a provider this graph consumes to depend on *objectstore.Store to
	// switch it on.
	loom.Provide(NewObjectStore),
{{- end}}
{{- if .Caps.Has "cron"}}
	// The scheduler is different from the bindings above: the graph root consumes
	// it, so Loom constructs it and registers its start/stop hooks. It takes the
	// server, so the socket is bound before the scheduler starts and the scheduler
	// stops before the server. It is defined in cron_provider.go, the stable
	// wiring seam, and starts no jobs until internal/cron/register.go registers
	// them.
	loom.Provide(NewScheduler),
{{- end}}
	loom.Provide(NewServer),
	loom.Provide(NewApp),
)

// App is the composed application the serve command runs. It is the composition
// root: it holds the configuration, the HTTP server and, when the api capability
// is installed, the API service the server serves. When the cron capability is
// installed it also holds the scheduler, so the graph constructs the scheduler
// and its start/stop hooks run with the server rather than being pruned.
//
// It deliberately holds no database service. With db installed the pool and
// repository exist as available bindings, but the default graph never depends on
// them, so serving the API never requires a database.
type App struct {
	Config *config.Config
	Server *Server
{{- if .Caps.Has "api"}}
	API api.Service
{{- end}}
{{- if .Caps.Has "cron"}}
	Scheduler *cron.Scheduler
{{- end}}
}

// NewApp is the graph root. The scheduler is taken after the server so the
// server's lifecycle hook is appended first.
func NewApp(cfg *config.Config, server *Server{{if .Caps.Has "api"}}, service api.Service{{end}}{{if .Caps.Has "cron"}}, scheduler *cron.Scheduler{{end}}) *App {
	return &App{Config: cfg, Server: server{{if .Caps.Has "api"}}, API: service{{end}}{{if .Caps.Has "cron"}}, Scheduler: scheduler{{end}}}
}

type addrKey struct{}

// WithAddr carries the serve listen address into the graph. It is only set when
// the command-line flag was provided, so it outranks the environment and the
// configuration file.
func WithAddr(ctx context.Context, addr string) context.Context {
	return context.WithValue(ctx, addrKey{}, addr)
}

type configPathKey struct{}

// WithConfigPath carries the --config path into the graph. An empty path means
// config.DefaultPath in the working directory.
func WithConfigPath(ctx context.Context, path string) context.Context {
	return context.WithValue(ctx, configPathKey{}, path)
}

// NewConfigLoader builds the configuration loader the graph binds. Production
// uses the filesystem and the process environment; a test builds a loader with
// fakes and provides it directly. The plain serve command uses the same loader,
// so configuration has one path in both compositions.
func NewConfigLoader() *config.Loader {
	return config.NewOsLoader()
}

// NewConfig loads the configuration through the injected loader, then applies
// the --addr override carried in the context.
//
// Precedence is flag, environment, file, defaults: the loader already applied
// the environment, the file and the defaults, and the context value is the
// command-line flag, so it wins. Only the HTTP settings are validated here; the
// database settings are validated by NewPool, which is the one constructor that
// needs them, so installing db does not require a credential to serve.
func NewConfig(ctx context.Context, loader *config.Loader) (*config.Config, error) {
	path := ""
	if value, ok := ctx.Value(configPathKey{}).(string); ok {
		path = value
	}
	cfg, err := loader.Load(path)
	if err != nil {
		return nil, err
	}
	if value, ok := ctx.Value(addrKey{}).(string); ok {
		if strings.TrimSpace(value) == "" {
			return nil, errors.New("di: listen address must not be blank")
		}
		cfg.HTTP.Addr = value
	}
	if err := cfg.Validate(); err != nil {
		return nil, err
	}
	return cfg, nil
}

// NewLogger constructs the application logger the graph binds.
//
// The logger is a graph dependency so every component that logs shares one
// handler; nothing installs a process-wide default logger. It writes to stderr,
// the sink a command-line server owns.
func NewLogger() *slog.Logger {
	return logging.New(os.Stderr, logging.TextFormat, nil)
}

{{if .Caps.Has "db"}}
// NewPool constructs the PostgreSQL pool and returns a cleanup that closes it.
//
// It is an available graph binding, not part of the default composition: Loom
// constructs it only when a provider depends on data.Repository, so an
// API-only serve never reaches it. The database settings are validated here
// rather than in NewConfig, so a project that installs db but does not use it
// needs no credential, and a project that does use it fails loudly instead of
// silently reaching a local database.
//
// pgxpool parses the dsn but connects only on first use, so the graph does not
// open a connection. The cleanup is registered with the lifecycle as soon as
// construction succeeds, so the pool is closed exactly once whether a later
// constructor fails or the lifecycle stops normally. The dsn is built from the
// validated configuration and is never logged.
func NewPool(ctx context.Context, cfg *config.Config) (*pgxpool.Pool, loom.Cleanup, error) {
	if err := cfg.ValidateDatabase(); err != nil {
		return nil, nil, err
	}
	pool, err := data.NewPool(ctx, cfg.DSN())
	if err != nil {
		return nil, nil, err
	}
	return pool, func(context.Context) error {
		pool.Close()
		return nil
	}, nil
}

// NewRepository binds the SQL-backed repository.
func NewRepository(pool *pgxpool.Pool) *data.PostgresRepository {
	return data.NewRepository(pool)
}
{{end}}
// newMux composes the application handler from the installed capabilities.
//
// Route composition is explicit here rather than through a global registry, so
// the dependency graph is the single source of composition. The reserved /api/
// namespace takes precedence over the SPA catch-all because net/http resolves
// the more specific pattern first.
func newMux({{if .Caps.Has "api"}}
	service api.Service,{{end}}{{range .Modules}}
	{{.Name}}Service {{.Name}}.Service,{{end}}
) *nethttp.ServeMux {
	mux := nethttp.NewServeMux()
{{- if .Caps.Has "web"}}
	mux.Handle("/", web.Handler())
{{- end}}
{{- if .Caps.Has "api"}}
	api.Register(mux, service)
{{- end}}
{{- range .Modules}}
	{{.Name}}.Register(mux, {{.Name}}Service)
{{- end}}
	return mux
}

// Server is the managed HTTP server the graph owns.
type Server struct {
	HTTP *nethttp.Server

	// logger records the server lifecycle: startup, a serve failure and a
	// graceful shutdown. It is the graph's injected logger.
	logger *slog.Logger
	// listener is the socket bound in OnStart. It is retained so the bound
	// address is inspectable and a test can close it to simulate a serve failure.
	listener net.Listener
	// fail reports how the serving goroutine ended: the serve error, or nil
	// after a graceful shutdown. It is buffered so the goroutine never blocks
	// when nothing reads it.
	fail chan error
}

// Fail reports how the serving goroutine ended. It yields the serve error, or
// nil when the server stopped gracefully.
func (s *Server) Fail() <-chan error { return s.fail }

// shutdownTimeout bounds graceful teardown when the lifecycle stops.
const shutdownTimeout = 10 * time.Second

// Stop gracefully stops the server within the shutdown timeout.
func (s *Server) Stop() error {
	ctx, cancel := context.WithTimeout(context.Background(), shutdownTimeout)
	defer cancel()
	return s.HTTP.Shutdown(ctx)
}

// NewServer builds the HTTP server for the composed handler and registers its
// start and stop hooks with the lifecycle.
//
// OnStart binds the listen address synchronously with net.Listen, so an address
// already in use fails Start instead of being lost in a background goroutine,
// then serves in the background. A serve failure is delivered on Fail so the
// serve command can stop and report it; a graceful shutdown delivers nil. The
// injected logger records the startup, failure and shutdown transitions.
func NewServer(
	lc *loom.Lifecycle,
	cfg *config.Config,
	logger *slog.Logger,{{if .Caps.Has "api"}}
	service api.Service,{{end}}{{range .Modules}}
	{{.Name}}Service {{.Name}}.Service,{{end}}
) (*Server, error) {
	server := &Server{
		// The composed mux is wrapped with the same middleware chain the plain
		// serve command uses (httpserver.Chain, declared in
		// internal/httpserver/middleware.go), so both compositions serve identical
		// middleware semantics.
		HTTP: httpserver.NewServer(cfg.HTTP.Addr, httpserver.Chain(logger, newMux({{if .Caps.Has "api"}}
			service,{{end}}{{range .Modules}}
			{{.Name}}Service,{{end}}
		))),
		logger: logger,
		fail:   make(chan error, 1),
	}
	lc.Append(loom.Hook{
		OnStart: func(context.Context) error {
			listener, err := net.Listen("tcp", cfg.HTTP.Addr)
			if err != nil {
				return fmt.Errorf("di: listen on %s: %w", cfg.HTTP.Addr, err)
			}
			server.listener = listener
			logger.Info("__name__ listening", "addr", listener.Addr().String())
{{- if .Caps.Has "api"}}
			logger.Info("__name__ API uses in-memory development data; items are lost on restart")
{{- end}}
			go func() {
				err := server.HTTP.Serve(listener)
				if errors.Is(err, nethttp.ErrServerClosed) {
					err = nil
				}
				if err != nil {
					logger.Error("__name__ serve failed", "error", err)
				}
				server.fail <- err
			}()
			return nil
		},
		OnStop: func(context.Context) error {
			logger.Info("__name__ shutting down")
			if err := server.Stop(); err != nil {
				logger.Error("__name__ shutdown failed", "error", err)
				return err
			}
			return nil
		},
	})
	return server, nil
}

{
  "name": "loom",
  "version": "0.1.0",
  "kind": "add",
  "summary": "Compile-time dependency injection: a Loom graph that wires the HTTP server and the in-memory JSON API service with lifecycle start/stop; the database is a library you wire in yourself.",
  "requires": ["http"],
  "di": {
    "dir": "internal/di",
    "source": "files/di.go.tmpl",
    "test": "files/di_test.go.tmpl"
  },
  "files": [
    { "path": "internal/app/serve_loom.go", "source": "files/serve_loom.go.tmpl" },
    { "path": "tools/loom/go.mod", "source": "files/tools/go.mod.tmpl" },
    { "path": "tools/loom/go.sum", "source": "files/tools/go.sum" },
    { "path": "internal/di/README.md", "source": "files/README.md" },
    { "path": "internal/di/api_provider.go", "source": "files/api_provider.go.tmpl", "when": ["api"] },
    { "path": "internal/di/redis_provider.go", "source": "files/redis_provider.go.tmpl", "when": ["redis"] },
    { "path": "internal/di/mail_provider.go", "source": "files/mail_provider.go.tmpl", "when": ["mail"] },
    { "path": "internal/di/storage_provider.go", "source": "files/storage_provider.go.tmpl", "when": ["storage"] },
    { "path": "internal/di/cron_provider.go", "source": "files/cron_provider.go.tmpl", "when": ["cron"] }
  ],
  "patches": [
    { "path": "internal/app/serve.go", "marker": "serve", "mode": "replace", "source": "files/serve.snippet" },
    { "path": "go.mod", "marker": "deps", "source": "files/go.mod.snippet" },
    { "path": "go.mod", "marker": "goversion", "mode": "replace", "source": "files/goversion.snippet" },
    { "path": "Makefile", "marker": "loom", "source": "files/Makefile.snippet" }
  ]
}

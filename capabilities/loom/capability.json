{
  "name": "loom",
  "version": "0.1.0",
  "kind": "add",
  "summary": "Compile-time dependency injection: a Loom graph that wires the HTTP server, the JSON API service and the PostgreSQL repository with lifecycle start/stop.",
  "requires": ["http"],
  "di": {
    "dir": "internal/di",
    "source": "files/di.go.tmpl",
    "test": "files/di_test.go.tmpl"
  },
  "files": [
    { "path": "internal/app/serve_loom.go", "source": "files/serve_loom.go.tmpl" },
    { "path": "tools/loom/go.mod", "source": "files/tools/go.mod.tmpl" },
    { "path": "tools/loom/go.sum", "source": "files/tools/go.sum" },
    { "path": "internal/di/README.md", "source": "files/README.md" }
  ],
  "patches": [
    { "path": "internal/app/serve.go", "marker": "serve", "mode": "replace", "source": "files/serve.snippet" },
    { "path": "go.mod", "marker": "deps", "source": "files/go.mod.snippet" },
    { "path": "go.mod", "marker": "goversion", "mode": "replace", "source": "files/goversion.snippet" },
    { "path": "Makefile", "marker": "loom", "source": "files/Makefile.snippet" }
  ]
}
